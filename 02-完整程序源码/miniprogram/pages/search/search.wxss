.search-container {
  padding: 0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部蓝渐变搜索栏（天眼通风格） */
.search-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #1E4976;
  padding: 24rpx 24rpx 36rpx;
  border-radius: 0 0 36rpx 36rpx;
  margin-bottom: 24rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 44rpx;
  padding: 18rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.search-icon-text { font-size: 32rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; color: #333; }

.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E0E0E0;
  border-radius: 50%;
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
}
.search-clear:active { background: #EF4444; color: #FFF; }

.search-btn {
  margin-left: 16rpx;
  padding: 18rpx 32rpx;
  background: #FFFFFF;
  color: #1E4976;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}
.search-btn:active { transform: scale(0.96); }

.search-body { padding: 0 24rpx 24rpx; }

/* 联想列表 */
.suggest-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.suggest-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.suggest-item:active { background: #F4F7FA; }
.suggest-item:last-child { border-bottom: none; }
.suggest-info { flex: 1; display: flex; align-items: center; }
.suggest-name { font-size: 28rpx; color: #333; font-weight: 500; }
.suggest-country {
  font-size: 22rpx; color: #999; margin-left: 16rpx;
  padding: 4rpx 12rpx; background: #F4F7FA; border-radius: 10rpx;
}
.suggest-arrow { font-size: 36rpx; color: #CCC; }
.suggest-item:active .suggest-arrow { color: #1E4976; transform: translateX(4rpx); }

/* 区域标题 */
.section { margin-bottom: 32rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: #333; }
.section-action { font-size: 24rpx; color: #1E4976; padding: 8rpx 16rpx; border-radius: 20rpx; background: rgba(30, 73, 118, 0.08); }

/* 搜索历史 */
.history-tags { display: flex; flex-wrap: wrap; }
.history-tag {
  padding: 12rpx 28rpx;
  background: #FFF;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.history-tag:active { background: #1E4976; color: #FFF; }

/* 空提示 */
.empty-tip { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-tip-icon { font-size: 96rpx; margin-bottom: 24rpx; opacity: 0.6; }
.empty-tip-text { font-size: 26rpx; color: #999; text-align: center; }

/* 搜索结果 */
.result-list { margin-bottom: 24rpx; }
.result-header { margin-bottom: 20rpx; padding-left: 4rpx; }
.result-count { font-size: 26rpx; color: #666; }
.count-number { color: #1E4976; font-weight: 700; font-size: 30rpx; }

.result-item {
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.result-header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.result-name { font-size: 32rpx; font-weight: 600; color: #333; flex: 1; margin-right: 16rpx; }
.result-risk-badge {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #FFF; font-size: 22rpx; font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}
.result-meta { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.meta-item { display: flex; align-items: center; font-size: 24rpx; color: #666; }
.meta-icon { font-size: 24rpx; margin-right: 6rpx; }
.result-country, .result-industry { color: #666; }

.result-score { display: flex; align-items: center; font-size: 26rpx; margin-bottom: 16rpx; }
.score-bar { flex: 1; height: 12rpx; background: #F0F0F0; border-radius: 6rpx; overflow: hidden; margin-right: 16rpx; }
.score-bar-fill { height: 100%; border-radius: 6rpx; transition: width 0.5s ease; }
.bar-high { background: #EF4444; }
.bar-medium { background: #F59E0B; }
.bar-low { background: #10B981; }
.score-label { color: #666; margin-right: 8rpx; }
.score-value { font-weight: 700; margin-right: 12rpx; }
.score-level-tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; font-weight: 500; }

.result-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 16rpx; border-top: 1rpx solid #F5F5F5; }
.result-arrow { font-size: 26rpx; color: #1E4976; font-weight: 500; }
.arrow-icon { font-size: 32rpx; color: #1E4976; font-weight: 700; }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-state .icon { font-size: 96rpx; margin-bottom: 24rpx; opacity: 0.6; }
.empty-state .text { font-size: 30rpx; color: #666; font-weight: 500; }
.empty-state .text-sub { font-size: 24rpx; color: #CCC; margin-top: 12rpx; }

/* 风险等级配色 */
.risk-bg-high { background: #EF4444; }
.risk-bg-medium { background: #F59E0B; }
.risk-bg-low { background: #10B981; }
.risk-high { color: #EF4444; }
.risk-medium { color: #F59E0B; }
.risk-low { color: #10B981; }
.tag-danger { background: rgba(245, 108, 108, 0.12); color: #EF4444; }
.tag-warning { background: rgba(230, 162, 60, 0.12); color: #F59E0B; }
.tag-success { background: rgba(16, 185, 129, 0.12); color: #10B981; }

