/*
 * ══════════════════════════════════════════════════════════
 * 首页布局优化：核心功能 + 更多工具
 * 解决"两个导航栏重复"问题
 * ══════════════════════════════════════════════════════════
 */

/* 统一分区容器 */
.ty-section {
  margin: var(--space-lg) var(--space-base) 0;
}

/* 区块标题：竖条 + 主标题 + 副标题 */
.ty-section-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-md);
  padding-left: var(--space-xs);
}

.ty-section-header .bar {
  width: 6rpx;
  height: 32rpx;
  background: var(--c-primary);
  border-radius: var(--radius-pill);
  margin-right: var(--space-sm);
}

.ty-section-header .txt {
  font-size: 30rpx;
  font-weight: var(--font-semibold);
  color: var(--c-text);
  letter-spacing: 1rpx;
}

.ty-section-header .sub {
  margin-left: var(--space-sm);
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--c-text-3);
  font-weight: var(--font-normal);
  opacity: 0.85;
}

/* ───── 核心功能：4 个大卡（一屏直达） ───── */

.core-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.core-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 184rpx;
  padding: 18rpx 6rpx 14rpx;
  background: #FFF;
  border: 1rpx solid var(--c-border, #E5E6EB);
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
  transition: all var(--duration-fast) var(--ease-in-out-quart, ease);
  overflow: hidden;
}

/* 顶部色条：使用 --card-bg，弱化为顶部细高光带 */
.core-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--card-bg, var(--c-primary-tint));
  opacity: 0.85;
}

.core-card:active {
  transform: scale(0.96);
  box-shadow: 0 1rpx 6rpx rgba(31, 35, 41, 0.06);
}

.core-card-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg, var(--c-primary-tint));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  transition: transform var(--duration-fast) var(--ease-in-out-quart, ease);
}

.core-card:active .core-card-icon {
  transform: scale(0.92);
}

/* 复用全局 glyph 样式，但缩小一档以适应大卡视觉 */
.core-card .ty-func-glyph {
  width: 40rpx;
  height: 40rpx;
}

.core-card-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 52rpx;
  font-size: 24rpx;
  font-weight: var(--font-semibold);
  color: var(--c-text);
  letter-spacing: 0.5rpx;
  line-height: 1.12;
  text-align: center;
  margin-bottom: 5rpx;
}

.core-card-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 38rpx;
  font-size: 18rpx;
  color: var(--c-text-3);
  font-weight: var(--font-normal);
  opacity: 0.85;
  text-align: center;
  line-height: 1.08;
}

/* ───── 更多工具：横滑收纳 ───── */

.more-scroll {
  /* 关键：让 scroll-view 横向可滑，并允许溢出滚动 */
  width: 100%;
  white-space: nowrap;
  /* 抵消外层 section 的左右内边距，让卡片能从屏幕边缘开始 */
  margin: 0 calc(-1 * var(--space-base));
  padding: 0;                       /* 左右间距移到 .more-track，避免 enhanced 模式下被吞 */
  box-sizing: border-box;
}

.more-track {
  display: inline-flex;
  gap: var(--space-sm);
  /* 左右间距作为滚动内容的一部分，首/末卡都有呼吸感且随内容滚动 */
  padding: 0 var(--space-base);
}

.more-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 156rpx;
  padding: var(--space-md) var(--space-xs);
  background: #FFF;
  border: 1rpx solid var(--c-border, #E5E6EB);
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
  flex-shrink: 0;
  transition: all var(--duration-fast) var(--ease-in-out-quart, ease);
}

.more-card:active {
  transform: scale(0.94);
  background: var(--card-bg, var(--c-primary-tint));
}

.more-card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  background: var(--card-bg, var(--c-primary-tint));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-xs);
}

.more-card:active .more-card-icon {
  background: #FFF;
}

.more-card .ty-func-glyph {
  width: 40rpx;
  height: 40rpx;
}

.more-card-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 21rpx;
  color: var(--c-text);
  font-weight: var(--font-medium);
  letter-spacing: 0.5rpx;
  text-align: center;
  line-height: 1.15;
  white-space: normal;
}
