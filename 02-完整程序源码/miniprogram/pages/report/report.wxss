.container {
  padding: 0 24rpx 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #F4F7FA;
}

/* 报告头部 - 优化 */
.report-header {
  position: relative;
  margin: 0 -24rpx 32rpx;
  padding: 0 24rpx 48rpx;
  overflow: hidden;
}

.report-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: #1E4976;
  border-radius: 0 0 40rpx 40rpx;
}

.report-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 64rpx 32rpx 0;
}

.report-icon {
  font-size: 72rpx;
  margin-right: 24rpx;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
}

.report-info {
  flex: 1;
  padding-top: 16rpx;
}

.report-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFF;
  margin-bottom: 8rpx;
}

.report-enterprise {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
}

.report-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.meta-item {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 搜索区域 */
.search-section {
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}

.search-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.search-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.search-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.search-box {
  display: flex;
  align-items: center;
  background: #F4F7FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  border: 2rpx solid #E4E7ED;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 88rpx;
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
  background: #E4E7ED;
  border-radius: 50%;
}

.suggest-list {
  margin-top: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #EBEEF5;
}

.suggest-item {
  padding: 24rpx;
  background: #FFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.suggest-item:last-child {
  border-bottom: none;
}

.suggest-item:active {
  background: #F4F7FA;
}

.suggest-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.suggest-code {
  font-size: 22rpx;
  color: #999;
  font-family: monospace;
}

.suggest-port {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  background: #ECF5FF;
  color: #409EFF;
  font-size: 22rpx;
  border-radius: 8rpx;
}

.search-empty {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #999;
}

/* 区域标题 - 优化 */
.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 无数据状态 - 新增 */
.empty-report {
  text-align: center;
  padding: 80rpx 40rpx;
  margin-bottom: 24rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.empty-action {
  display: inline-flex;
  align-items: center;
  padding: 20rpx 40rpx;
  background: #1E4976;
  color: #FFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.10);
  transition: all 0.3s ease;
}

.empty-action:active {
  transform: scale(0.96);
}

.action-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 28rpx;
}

/* 信息列表 - 优化 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.info-item:active {
  background: #F4F7FA;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF;
  border-radius: 12rpx;
}

.info-content {
  flex: 1;
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  word-break: break-all;
  line-height: 1.6;
}

/* 评分概览 - 优化 */
.score-overview {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}

.score-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.score-high {
  background: #EF4444;
  color: #FFF;
}

.score-medium {
  background: #F59E0B;
  color: #FFF;
}

.score-low {
  background: #10B981;
  color: #FFF;
}

.score-number {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.score-unit {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.score-level-badge {
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.risk-badge-high {
  background: #EF4444;
  color: #FFF;
}

.risk-badge-medium {
  background: #F59E0B;
  color: #FFF;
}

.risk-badge-low {
  background: #10B981;
  color: #FFF;
}

/* 维度分析 - 优化 */
.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.dimension-item {
  padding: 20rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
}

.dimension-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dimension-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.dim-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.dim-score {
  font-size: 28rpx;
  color: #333;
  font-weight: 700;
}

/* 进度条 */
.progress-bar {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.6s ease;
}

/* 风险事项 - 优化 */
.risk-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.risk-item {
  padding: 24rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.risk-item:active {
  background: #F4F7FA;
}

.risk-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.risk-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.risk-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.risk-item-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.risk-footer {
  display: flex;
  align-items: center;
}

.risk-item-date {
  font-size: 22rpx;
  color: #B0B0B0;
}

/* 数据来源声明 - 优化 */
.data-source {
  margin-top: 48rpx;
  padding: 32rpx 24rpx;
  background: #FFF;
  border-radius: 20rpx;
  text-align: center;
}

.source-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.source-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.source-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
}

.source-content {
  font-size: 22rpx;
  color: #999;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.source-footer {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.source-time {
  font-size: 20rpx;
  color: #B0B0B0;
}

.source-notice {
  font-size: 20rpx;
  color: #CCC;
}

/* 保存报告图片 */
.poster-btn {
  margin: 0 0 24rpx;
  background: #1E4976;
  color: #FFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 20rpx 0;
}
.poster-btn::after {
  border: none;
}
.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 600rpx;
  height: 920rpx;
}

