.container {
  padding: 0 var(--space-md) var(--space-md);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 页面头部 — 渐变背景 */
.ty-page-head {
  background: var(--gradient-primary);
  margin: 0 calc(-1 * var(--space-md)) var(--space-lg);
  padding: var(--space-xl) var(--space-lg) 48rpx;
  color: #FFFFFF;
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  position: relative;
  overflow: hidden;
}

.ty-page-head::before {
  content: '';
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  top: -120rpx;
  right: -80rpx;
}

/* ══════════ 统计卡片系统 ══════════ */
.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: var(--space-lg);
}
.translation-switch { display: inline-flex; margin: -6rpx 0 18rpx; padding: 10rpx 18rpx; border-radius: 20rpx; color: var(--c-primary); background: var(--c-primary-tint); font-size: 21rpx; }
.translation-meta { margin: -4rpx 0 14rpx; font-size: 20rpx; color: var(--c-text-3); }

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-md) 20rpx;
  background: var(--gradient-card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--c-border-light);
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}

/* 统计卡片顶部高光条 */
.stat-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;
  height: 3rpx;
  border-radius: 0 0 2rpx 2rpx;
  opacity: 0.8;
}

.stat-high { --stat-color: var(--c-danger); }
.stat-medium { --stat-color: var(--c-warning); }
.stat-low { --stat-color: var(--c-success); }

.stat-high::after { background: var(--c-danger); }
.stat-medium::after { background: var(--c-warning); }
.stat-low::after { background: var(--c-success); }

.stat-num {
  font-size: 48rpx;
  font-weight: var(--font-extrabold);
  margin-bottom: 8rpx;
  line-height: 1.1;
}

.stat-high .stat-num { color: var(--c-danger); }
.stat-medium .stat-num { color: var(--c-warning); }
.stat-low .stat-num { color: var(--c-success); }

.stat-label {
  font-size: var(--text-xs);
  color: var(--c-text-3);
  font-weight: var(--font-medium);
}

/* ══════════ 预警卡片系统 ══════════ */
.warning-item {
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  border-left: 6rpx solid transparent;
  border-radius: var(--radius-sm);
  background: var(--gradient-card);
  border: 1rpx solid var(--c-border-light);
  box-shadow: var(--shadow-xs);
  transition:
    transform var(--duration-normal) var(--ease-in-out-quart),
    box-shadow var(--duration-normal) var(--ease-in-out-quart),
    border-color var(--duration-fast) ease;
}

.warning-item:active {
  transform: translateY(-2rpx) scale(0.995);
  box-shadow: var(--shadow-sm);
}

.warning-item.warning-level-high {
  border-left-color: var(--c-danger);
}

.warning-item.warning-level-medium {
  border-left-color: var(--c-warning);
}

.warning-item.warning-level-low {
  border-left-color: var(--c-success);
}

.warning-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.warning-level-badge {
  display: flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: var(--text-xs);
  font-weight: var(--font-semibold);
  transition: all var(--duration-fast) ease;
}

.warning-level-badge:active {
  transform: scale(0.96);
}

.warning-level-high .warning-level-badge {
  background: var(--c-danger-light);
  color: var(--c-danger);
  border: 1rpx solid var(--c-danger-border);
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.12);
}

.warning-level-medium .warning-level-badge {
  background: var(--c-warning-light);
  color: var(--c-warning);
  border: 1rpx solid var(--c-warning-border);
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.12);
}

.warning-level-low .warning-level-badge {
  background: var(--c-success-light);
  color: var(--c-success);
  border: 1rpx solid var(--c-success-border);
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.12);
}

.level-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.level-text {
  font-size: var(--text-xs);
}

.warning-time {
  font-size: var(--text-xs);
  color: var(--c-text-3);
  font-weight: var(--font-normal);
}

/* 企业名称区块 */
.warning-enterprise {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
  padding: 14rpx 18rpx;
  background: var(--c-surface);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--c-border-light);
}

.enterprise-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  color: var(--c-accent);
}

.enterprise-name {
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  color: var(--c-text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 预警内容 */
.warning-content {
  font-size: var(--text-sm);
  color: var(--c-text-2);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-sm);
  padding: 18rpx;
  background: var(--c-surface);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--c-divider);
}

/* 预警底部操作区 */
.warning-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--c-divider);
}

.warning-action {
  display: flex;
  align-items: center;
  font-size: var(--text-sm);
  color: var(--c-danger);
  font-weight: var(--font-semibold);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  transition: all var(--duration-fast) ease;
}

.warning-action:active {
  background: var(--c-danger-light);
  transform: scale(0.96);
}

.action-arrow {
  font-size: 30rpx;
  margin-left: 6rpx;
  font-weight: var(--font-bold);
}

/* ══════════ 空状态与加载态 ══════════ */
.empty-state .text-sub {
  font-size: var(--text-sm);
  color: var(--c-placeholder);
  margin-top: var(--space-xs);
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-lg);
  color: var(--c-text-3);
  font-size: var(--text-sm);
}

.loading-text {
  margin-left: 14rpx;
}

.no-more {
  text-align: center;
  padding: var(--space-lg);
}

.no-more-text {
  font-size: var(--text-sm);
  color: var(--c-placeholder);
}

/* 数据来源声明 */
.data-source {
  margin-top: var(--space-xl);
  padding: var(--space-lg) var(--space-md);
  background: var(--gradient-card);
  border-radius: var(--radius-lg);
  text-align: center;
  border: 1rpx solid var(--c-border-light);
  box-shadow: var(--shadow-xs);
}

.source-title {
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  color: var(--c-text-2);
  margin-bottom: var(--space-sm);
}

.source-content {
  font-size: var(--text-xs);
  color: var(--c-text-3);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-xs);
}

.source-notice {
  font-size: 20rpx;
  color: var(--c-placeholder);
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--c-divider);
}

.sub-text {
  font-size: var(--text-xs);
  color: var(--c-placeholder);
  margin-top: var(--space-xs);
}

/*
 * ══════════ 跨境欺诈前置预警卡片（特色功能）══════════
 * 差异化：渐变深靛蓝底 + 玻璃质感
 */
.predict-card {
  background: linear-gradient(135deg, #152D4A 0%, #1E4976 50%, #2563EB 100%);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  margin-bottom: var(--space-lg);
  box-shadow:
    var(--shadow-lg),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
}

/* 装饰性光晕 */
.predict-card::before {
  content: '';
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 191, 165, 0.15) 0%, transparent 70%);
  top: -60rpx;
  right: -40rpx;
}

.predict-title {
  font-size: var(--text-xl);
  font-weight: var(--font-bold);
  color: #FFF;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
}

.predict-sub {
  font-size: var(--text-xs);
  color: rgba(255, 255, 255, 0.72);
  margin-left: 18rpx;
  font-weight: var(--font-normal);
}

.predict-ent {
  font-size: var(--text-base);
  color: rgba(255, 255, 255, 0.88);
  margin: var(--space-sm) 0 var(--space-md);
  position: relative;
  z-index: 1;
}

.predict-risk {
  margin-bottom: var(--space-md);
  position: relative;
  z-index: 1;
}

.pr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.pr-type {
  font-size: var(--text-base);
  color: #FFF;
  font-weight: var(--font-medium);
}

.pr-prob {
  font-size: 36rpx;
  font-weight: var(--font-extrabold);
  letter-spacing: -0.5rpx;
}

.pr-prob.high { color: #FF6B6B; text-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.4); }
.pr-prob.medium { color: #FFD166; text-shadow: 0 2rpx 8rpx rgba(255, 209, 102, 0.35); }
.pr-prob.low { color: #8CE99A; text-shadow: 0 2rpx 8rpx rgba(140, 233, 154, 0.35); }

.pr-bar {
  height: 14rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 7rpx;
  overflow: hidden;
  margin: 10rpx 0;
}

.pr-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.6s var(--ease-out-expo);
}

.pr-fill.high { background: linear-gradient(90deg, #EF4444 0%, #F87171 100%); }
.pr-fill.medium { background: linear-gradient(90deg, #F59E0B 0%, #FBBF24 100%); }
.pr-fill.low { background: linear-gradient(90deg, #10B981 0%, #34D399 100%); }

.pr-desc {
  font-size: var(--text-xs);
  color: rgba(255, 255, 255, 0.72);
  line-height: var(--leading-relaxed);
}
