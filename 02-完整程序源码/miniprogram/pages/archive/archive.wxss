.container { padding: 24rpx; }
.page-header { position: relative; margin-bottom: 24rpx; }
.page-title { font-size: 38rpx; font-weight: 700; color: #1E4976; }
.page-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.language-link { position: absolute; right: 0; top: 4rpx; padding: 8rpx 16rpx; font-size: 22rpx; color: #1E4976; background: #EAF1FF; border-radius: 20rpx; }

.search-bar { display: flex; align-items: center; background: #FFF; border-radius: 16rpx; padding: 8rpx 8rpx 8rpx 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06); margin-bottom: 24rpx; }
.search-input { flex: 1; height: 72rpx; font-size: 28rpx; }
.search-btn { background: #1E4976; color: #FFF; font-size: 28rpx; padding: 16rpx 36rpx; border-radius: 12rpx; }

.card { background: #FFF; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06); }
.card-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; }

.align-name { font-size: 32rpx; font-weight: 700; color: var(--c-text); }
.align-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.country-tabs { white-space: nowrap; margin-bottom: 24rpx; }
.ctab { display: inline-block; padding: 14rpx 32rpx; background: #FFF; border-radius: 30rpx; font-size: 26rpx; color: #666; margin-right: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.ctab.active { background: #1E4976; color: #FFF; }

.info-row { display: flex; padding: 14rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.info-label { width: 180rpx; color: #999; font-size: 26rpx; }
.info-value { flex: 1; color: #333; font-size: 26rpx; word-break: break-all; }
.info-value.hl { color: #1E4976; font-weight: 700; }
.translate-note { margin-top: 16rpx; font-size: 24rpx; color: var(--c-text-2); background: var(--c-primary-tint); padding: 16rpx; border-radius: 12rpx; }
.trace-panel { margin-top: 16rpx; padding: 16rpx; border-radius: 12rpx; background: #F8FAFD; border: 1rpx dashed #B9C9DE; }
.trace-title { display: block; color: #1E4976; font-size: 23rpx; font-weight: 600; margin-bottom: 8rpx; }
.trace-line { display: block; color: #58677A; font-size: 21rpx; line-height: 1.55; }
.trace-note { display: block; margin-top: 8rpx; color: #8A96A8; font-size: 19rpx; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 80rpx 40rpx; }
.empty-state .icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-state .text { font-size: 28rpx; color: #666; }
.empty-state .text-sub { font-size: 22rpx; color: #CCC; margin-top: 12rpx; text-align: center; }

