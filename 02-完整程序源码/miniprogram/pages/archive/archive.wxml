<view class="container">
  <view class="page-header">
    <view class="page-title">{{i18n.archive.title}}</view>
    <view class="language-link" bindtap="onChooseLanguage">{{languageShort}} ▾</view>
    <view class="page-desc">{{i18n.archive.desc}}</view>
  </view>

  <view class="search-bar">
    <input class="search-input" placeholder="{{i18n.archive.placeholder}}" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" />
    <view class="search-btn" bindtap="onSearch">{{i18n.archive.fetch}}</view>
  </view>

  <block wx:if="{{archive}}">
    <view class="card">
      <view class="card-title">{{i18n.archive.entity}}</view>
      <view class="align-name">{{archive.enterpriseName}}</view>
      <view class="align-sub">{{i18n.archive.alignedText}}</view>
    </view>

    <scroll-view class="country-tabs" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
      <view class="ctab {{activeCountry === item ? 'active' : ''}}" wx:for="{{countries}}" wx:key="*this" bindtap="onSwitchCountry" data-country="{{item}}">{{item}}</view>
    </scroll-view>

    <view class="card" wx:if="{{archive.items}}">
      <view class="card-title">{{activeCountry}} · {{i18n.archive.localArchive}}</view>
      <view class="info-row"><text class="info-label">{{i18n.archive.localName}}</text><text class="info-value">{{activeItem.localName}}</text></view>
      <view class="info-row"><text class="info-label">{{i18n.archive.legal}}</text><text class="info-value">{{activeItem.legalPerson}}</text></view>
      <view class="info-row"><text class="info-label">{{i18n.archive.scope}}</text><text class="info-value">{{activeItem.businessScope}}</text></view>
      <view class="info-row"><text class="info-label">{{i18n.archive.hs}}</text><text class="info-value hl">{{activeItem.hsCode}}</text></view>
      <view class="info-row"><text class="info-label">{{i18n.archive.category}}</text><text class="info-value">{{activeItem.hsDesc}}</text></view>
      <view class="info-row"><text class="info-label">{{i18n.archive.customs}}</text><text class="info-value">{{activeItem.customsRecord}}</text></view>
      <view class="translate-note">🔤 {{activeItem.translateNote}}</view>
      <view class="trace-panel">
        <text class="trace-title">🔎 {{i18n.archive.trace}}</text>
        <text class="trace-line">{{i18n.archive.original}}: {{activeItem.localName}}</text>
        <text class="trace-line">{{i18n.archive.alias}}: {{activeItem.translateNote}}</text>
        <text class="trace-note">{{i18n.archive.demo}}</text>
      </view>
    </view>
  </block>

  <view class="empty-state" wx:elif="{{!loading}}">
    <text class="icon">🌐</text>
    <text class="text">{{i18n.archive.empty}}</text>
    <text class="text-sub">{{i18n.archive.emptySub}}</text>
  </view>

  <data-source />
</view>
