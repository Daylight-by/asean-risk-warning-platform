.container {
  padding: 0 var(--space-md) var(--space-md);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 页面头部 — 渐变背景 */
.ty-page-head {
  background: var(--gradient-primary);
  margin: 0 calc(-1 * var(--space-md)) var(--space-lg);
  padding: var(--space-xl) var(--space-lg) 48rpx;
  color: #FFFFFF;
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  position: relative;
  overflow: hidden;
}

.ty-page-head::before {
  content: '';
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  top: -100rpx;
  right: -60rpx;
}

/* ══════════ 搜索栏（新拟态风格）═══════════ */
.search-box {
  margin-bottom: var(--space-lg);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: var(--radius-pill);
  padding: 22rpx 28rpx;
  box-shadow:
    var(--shadow-sm),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid transparent;
  transition:
    box-shadow var(--duration-normal) ease,
    border-color var(--duration-fast) ease;
}


.search-icon-text {
  font-size: 34rpx;
  margin-right: 14rpx;
  color: var(--c-accent);
}

.search-input {
  flex: 1;
  font-size: var(--text-base);
  color: var(--c-text);
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--c-border);
  border-radius: 50%;
  font-size: 24rpx;
  color: var(--c-text-3);
  margin-left: 14rpx;
  transition: all var(--duration-fast) ease;
}

.search-clear:active {
  background: var(--c-danger-light);
  color: var(--c-danger);
  transform: scale(0.92);
}

/* ══════════ 国家筛选标签 ══════════ */
.country-filter {
  white-space: nowrap;
  margin-bottom: var(--space-xl);
  padding-bottom: var(--space-xs);
}
.translation-switch { display: inline-flex; margin: -10rpx 0 20rpx; padding: 10rpx 18rpx; border-radius: 20rpx; color: var(--c-primary); background: var(--c-primary-tint); font-size: 21rpx; }
.translation-meta { margin: -4rpx 0 16rpx; font-size: 20rpx; color: var(--c-text-3); }

.country-tag {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 30rpx;
  background: var(--gradient-card);
  border-radius: var(--radius-pill);
  font-size: var(--text-sm);
  color: var(--c-text-2);
  margin-right: 18rpx;
  margin-bottom: 10rpx;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--c-border-light);
  font-weight: var(--font-medium);
  transition: all var(--duration-normal) var(--ease-in-out-quart);
  position: relative;
  overflow: hidden;
}

.country-tag::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--gradient-primary);
  opacity: 0;
  transition: opacity var(--duration-normal) ease;
}

.country-tag:active {
  transform: scale(0.96);
}

.country-tag.active {
  color: #FFF;
  border-color: transparent;
  box-shadow: var(--shadow-primary);
}

.country-tag.active::after {
  opacity: 1;
}

.country-tag text,
.country-tag .text {
  position: relative;
  z-index: 1;
}

/* ══════════ 政策卡片系统 ══════════ */
.policy-item {
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  border-left: 6rpx solid transparent;
  border-radius: var(--radius-sm);
  background: var(--gradient-card);
  border: 1rpx solid var(--c-border-light);
  box-shadow: var(--shadow-xs);
  transition:
    transform var(--duration-normal) var(--ease-in-out-quart),
    box-shadow var(--duration-normal) var(--ease-in-out-quart),
    border-left-color var(--duration-fast) ease;
}

.policy-item:active {
  transform: translateY(-2rpx) scale(0.995);
  box-shadow: var(--shadow-sm);
}

.policy-item:nth-child(3n+1) { border-left-color: var(--c-primary); }
.policy-item:nth-child(3n+2) { border-left-color: var(--c-accent); }
.policy-item:nth-child(3n) { border-left-color: var(--c-warning); }

.policy-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.policy-country-badge {
  display: flex;
  align-items: center;
  padding: 10rpx 18rpx;
  background: var(--c-surface);
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--c-border-light);
}

.country-flag {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.country-name {
  font-size: var(--text-sm);
  color: var(--c-text-2);
  font-weight: var(--font-medium);
}

.policy-date {
  font-size: var(--text-xs);
  color: var(--c-placeholder);
  font-weight: var(--font-normal);
}

.policy-title {
  font-size: var(--text-lg);
  font-weight: var(--font-bold);
  color: var(--c-text);
  margin-bottom: var(--space-sm);
  line-height: var(--leading-snug);
  letter-spacing: 0.5rpx;
}

.policy-summary {
  font-size: var(--text-sm);
  color: var(--c-text-3);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-sm);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.policy-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: var(--space-sm);
  gap: 12rpx;
}

.policy-tag {
  font-size: var(--text-xs);
  color: var(--c-primary);
  background: var(--c-primary-tint);
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  font-weight: var(--font-medium);
  border: 1rpx solid rgba(30, 73, 118, 0.12);
  transition: all var(--duration-fast) ease;
}

.policy-tag:active {
  background: var(--c-primary);
  color: #FFF;
  transform: scale(0.96);
}

.policy-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--c-divider);
}

.policy-source {
  display: flex;
  align-items: center;
  font-size: var(--text-xs);
  color: var(--c-placeholder);
}

.source-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.policy-action {
  display: flex;
  align-items: center;
  font-size: var(--text-sm);
  color: var(--c-primary);
  font-weight: var(--font-semibold);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  transition: all var(--duration-fast) ease;
}

.policy-action:active {
  background: var(--c-primary-tint);
  transform: scale(0.96);
}

.action-arrow {
  font-size: 28rpx;
  margin-left: 6rpx;
  font-weight: var(--font-bold);
}

/* ══════════ 空状态与加载态 ══════════ */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-lg);
  color: var(--c-text-3);
  font-size: var(--text-sm);
}

.loading-text {
  margin-left: 14rpx;
}

.empty-state .text-sub {
  font-size: var(--text-sm);
  color: var(--c-placeholder);
  margin-top: var(--space-xs);
}

.no-more {
  text-align: center;
  padding: var(--space-lg);
}

.no-more-text {
  font-size: var(--text-sm);
  color: var(--c-placeholder);
}

/* 数据来源声明 */
.data-source {
  margin-top: var(--space-xl);
  padding: var(--space-lg) var(--space-md);
  background: var(--gradient-card);
  border-radius: var(--radius-lg);
  text-align: center;
  border: 1rpx solid var(--c-border-light);
  box-shadow: var(--shadow-xs);
}

.source-title {
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  color: var(--c-text-2);
  margin-bottom: var(--space-sm);
}

.source-content {
  font-size: var(--text-xs);
  color: var(--c-text-3);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-xs);
}

.source-update {
  font-size: 20rpx;
  color: var(--c-placeholder);
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--c-divider);
}
