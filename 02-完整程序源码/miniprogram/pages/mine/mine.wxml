<view class="container">
  <!-- 用户头部 -->
  <view class="user-header">
    <view class="user-bg"></view>
    <view class="user-content">
      <view class="user-avatar">
        <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <text class="avatar-icon">👤</text>
        </view>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || i18n.mine.merchant}}</text>
        <text class="user-desc">{{i18n.mine.role}}</text>
      </view>
    </view>
  </view>

  <!-- 统计卡片 - 优化 -->
  <view class="stats-card card">
    <view class="stats-header">
      <text class="stats-title">{{i18n.mine.data}}</text>
    </view>
    <view class="stats-grid">
      <view class="stat-item" bindtap="onGoWarning">
        <view class="stat-icon-wrapper stat-warning">
          <text class="stat-icon">🔔</text>
        </view>
        <text class="stat-num">{{stats.warningCount}}</text>
        <text class="stat-label">{{i18n.mine.alerts}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onGoSubscribe">
        <view class="stat-icon-wrapper stat-subscribe">
          <text class="stat-icon">📌</text>
        </view>
        <text class="stat-num">{{stats.subscribeCount}}</text>
        <text class="stat-label">{{i18n.mine.subscriptions}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onGoPolicy">
        <view class="stat-icon-wrapper stat-policy">
          <text class="stat-icon">📋</text>
        </view>
        <text class="stat-num">{{stats.policyCount}}</text>
        <text class="stat-label">{{i18n.mine.updates}}</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 - 优化 -->
  <view class="menu-section">
    <view class="menu-group-title">{{i18n.mine.services}}</view>
    <view class="menu-group card">
      <view class="menu-item" bindtap="onGoWarning">
        <view class="menu-left">
          <view class="menu-icon-wrapper menu-warning">
            <text class="menu-icon">🔔</text>
          </view>
          <text class="menu-text">{{i18n.mine.alertList}}</text>
        </view>
        <view class="menu-right">
          <view class="menu-badge" wx:if="{{stats.warningCount > 0}}">{{stats.warningCount > 99 ? '99+' : stats.warningCount}}</view>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="menu-item" bindtap="onGoSubscribe">
        <view class="menu-left">
          <view class="menu-icon-wrapper menu-subscribe">
            <text class="menu-icon">📌</text>
          </view>
          <text class="menu-text">{{i18n.mine.subscriptions}}</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="menu-item" bindtap="onGoHistory">
        <view class="menu-left">
          <view class="menu-icon-wrapper menu-history">
            <text class="menu-icon">🕐</text>
          </view>
          <text class="menu-text">{{i18n.mine.history}}</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="menu-item" bindtap="onGoPolicy">
        <view class="menu-left">
          <view class="menu-icon-wrapper menu-policy">
            <text class="menu-icon">📋</text>
          </view>
          <text class="menu-text">{{i18n.mine.policy}}</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="menu-group-title">{{i18n.mine.settings}}</view>
    <view class="menu-group card">
      <view class="menu-item" bindtap="onGoAbout">
        <view class="menu-left">
          <view class="menu-icon-wrapper menu-about">
            <text class="menu-icon">ℹ️</text>
          </view>
          <text class="menu-text">{{i18n.mine.about}}</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="menu-item" bindtap="onChooseLanguage">
        <view class="menu-left">
          <view class="menu-icon-wrapper menu-language">
            <text class="menu-icon">🌐</text>
          </view>
          <view>
            <text class="menu-text">{{i18n.mine.language}}</text>
            <text class="menu-subtext">{{i18n.mine.languageDesc}}</text>
          </view>
        </view>
        <view class="menu-right">
          <text class="menu-cache-size">{{languageLabel}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="menu-item" bindtap="onClearCache">
        <view class="menu-left">
          <view class="menu-icon-wrapper menu-cache">
            <text class="menu-icon">🗑️</text>
          </view>
          <text class="menu-text">{{i18n.mine.cache}}</text>
        </view>
        <view class="menu-right">
          <text class="menu-cache-size">{{cacheSize || '--'}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部声明 -->
  <view class="footer">
    <view class="footer-logo">🌏</view>
    <view class="footer-title">{{t.mine.platformName}}</view>
    <view class="footer-desc">{{i18n.mine.demo}}</view>
    <data-source />
  <view class="footer-version">Version 1.0.0</view>
  </view>
</view>
