.container {
  padding: var(--space-md);
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--c-bg);
}

/* ══════════ 页面头部（统一渐变风格）═══════════ */
.page-header {
  margin-bottom: var(--space-lg);
  background: var(--gradient-primary);
  margin: 0 calc(-1 * var(--space-md)) var(--space-xl);
  padding: var(--space-xl) var(--space-lg) 48rpx;
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  top: -120rpx;
  right: -80rpx;
}

.page-title {
  font-size: var(--text-3xl);
  font-weight: var(--font-bold);
  color: #FFF;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.page-desc {
  font-size: var(--text-sm);
  color: rgba(255, 255, 255, 0.88);
  margin-top: 10rpx;
  position: relative;
  z-index: 1;
  font-weight: var(--font-normal);
}

/* ══════════ 统计卡片（2x2 网格，小屏更易读）═══════════ */
.stat-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
}

.stat-card {
  background: var(--gradient-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg) var(--space-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--c-border-light);
  position: relative;
  overflow: hidden;
  transition: transform var(--duration-normal) var(--ease-in-out-quart),
              box-shadow var(--duration-normal) var(--ease-in-out-quart);
}

.stat-card:active {
  transform: translateY(-2rpx) scale(0.98);
  box-shadow: var(--shadow-md);
}

.stat-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 3rpx;
  border-radius: 0 0 2rpx 2rpx;
  background: var(--gradient-primary);
  opacity: 0.6;
}

.stat-num {
  font-size: 48rpx;
  font-weight: var(--font-extrabold);
  color: var(--c-primary);
  margin-bottom: 8rpx;
  line-height: 1.1;
  letter-spacing: -1rpx;
}

.stat-label {
  font-size: var(--text-xs);
  color: var(--c-text-3);
  font-weight: var(--font-medium);
}

/* ══════════ 通用卡片 ════════════ */
.card {
  background: var(--gradient-card);
  border-radius: var(--radius-md);
  padding: var(--space-lg) var(--space-md);
  margin-bottom: var(--space-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--c-border-light);
  position: relative;
  overflow: hidden;
  transition: transform var(--duration-normal) var(--ease-in-out-quart),
              box-shadow var(--duration-normal) var(--ease-in-out-quart);
}

.card:hover {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-md);
}

/* ══════════ 风险地图 ════════════ */
.map-card {
  padding-bottom: var(--space-md);
}

.section-sub {
  font-size: var(--text-xs);
  color: var(--c-text-3);
  font-weight: var(--font-normal);
}

.risk-map {
  width: 100%;
  height: 380rpx;
  border-radius: var(--radius-sm);
  margin-top: var(--space-sm);
  border: 1rpx solid var(--c-border-light);
}

.section-header {
  margin-bottom: var(--space-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: var(--text-xl);
  font-weight: var(--font-bold);
  color: var(--c-text);
  display: flex;
  align-items: center;
  letter-spacing: 0.5rpx;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: var(--gradient-primary);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* ══════════ 环形图 ════════════ */
.donut-wrap {
  display: flex;
  align-items: center;
}

.donut-canvas {
  width: 280rpx;
  height: 280rpx;
  flex-shrink: 0;
}

.donut-legend {
  flex: 1;
  padding-left: var(--space-lg);
}

.legend-item {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-md);
}

.legend-item:last-child {
  margin-bottom: 0;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(26, 35, 50, 0.12);
}

.legend-text {
  font-size: var(--text-sm);
  color: var(--c-text-2);
  font-weight: var(--font-medium);
}

/* ══════════ 趋势图 ════════════ */
.trend-wrap {
  width: 100%;
}

.trend-canvas {
  width: 100%;
  height: 320rpx;
}

/* ══════════ 最新预警列表 ════════════ */
.recent-item {
  display: flex;
  padding: var(--space-md) 0;
  border-bottom: 1rpx solid var(--c-divider);
  transition: background var(--duration-fast) ease;
}

.recent-item:active {
  background: var(--c-surface);
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-level {
  flex-shrink: 0;
  font-size: var(--text-xs);
  color: #FFF;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  height: fit-content;
  margin-right: var(--space-sm);
  font-weight: var(--font-semibold);
  box-shadow: 0 2rpx 8rpx rgba(26, 35, 50, 0.15);
}

.recent-level-high { background: var(--c-danger); }
.recent-level-medium { background: var(--c-warning); }
.recent-level-low { background: var(--c-success); }

.recent-body {
  flex: 1;
}

.recent-name {
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  color: var(--c-text);
  margin-bottom: var(--space-xs);
}

.recent-content {
  font-size: var(--text-sm);
  color: var(--c-text-3);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-xs);
}

.recent-time {
  font-size: var(--text-xs);
  color: var(--c-placeholder);
}

/* ══════════ 加载 / 数据来源 ════════════ */
.loading-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid var(--c-border);
  border-top-color: var(--c-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: var(--text-sm);
  color: var(--c-text-3);
  margin-top: var(--space-md);
  font-weight: var(--font-medium);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.data-source {
  background: var(--gradient-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg) var(--space-md);
  text-align: center;
  border: 1rpx solid var(--c-border-light);
  box-shadow: var(--shadow-xs);
}

.source-title {
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  color: var(--c-text-2);
  margin-bottom: var(--space-sm);
}

.source-content {
  font-size: var(--text-xs);
  color: var(--c-text-3);
  line-height: var(--leading-relaxed);
}

.source-notice {
  font-size: 20rpx;
  color: var(--c-placeholder);
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--c-divider);
}
