.container { padding: 24rpx; }
.page-header { margin-bottom: 24rpx; }
.page-title { font-size: 38rpx; font-weight: 700; color: #1E4976; }
.page-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.search-bar { display: flex; align-items: center; background: #FFF; border-radius: 16rpx; padding: 8rpx 8rpx 8rpx 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06); margin-bottom: 24rpx; }
.search-input { flex: 1; height: 72rpx; font-size: 28rpx; }
.search-btn { background: #1E4976; color: #FFF; font-size: 28rpx; padding: 16rpx 36rpx; border-radius: 12rpx; }

.card { background: #FFF; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06); }
.card-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; }

.chain { display: flex; flex-direction: column; }
.chain-node { border-radius: 16rpx; padding: 20rpx; border-left: 8rpx solid #999; background: #F7F9FC; margin-bottom: 4rpx; }
.chain-node.high { border-left-color: #EF4444; background: rgba(245,108,108,0.06); }
.chain-node.medium { border-left-color: #F59E0B; background: rgba(230,162,60,0.06); }
.chain-node.low { border-left-color: #10B981; background: rgba(16, 185, 129,0.06); }
.chain-layer { font-size: 22rpx; color: #999; }
.chain-name { font-size: 28rpx; font-weight: 600; color: #333; margin: 4rpx 0; }
.chain-country { font-size: 24rpx; color: #1E4976; }
.chain-note { font-size: 22rpx; color: #EF4444; margin-top: 6rpx; }
.chain-arrow { text-align: center; color: #CCC; font-size: 24rpx; padding: 4rpx 0; }

.risk-line { display: flex; align-items: flex-start; padding: 14rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.risk-dot { color: #EF4444; font-size: 20rpx; margin-right: 12rpx; margin-top: 6rpx; }
.risk-text { flex: 1; font-size: 26rpx; color: #333; }

.alert-box { display: flex; align-items: flex-start; background: rgba(245,108,108,0.08); border-radius: 16rpx; padding: 24rpx; }
.alert-icon { font-size: 32rpx; margin-right: 12rpx; }
.alert-text { flex: 1; font-size: 26rpx; color: #EF4444; line-height: 1.5; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 80rpx 40rpx; }
.empty-state .icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-state .text { font-size: 28rpx; color: #666; }
.empty-state .text-sub { font-size: 22rpx; color: #CCC; margin-top: 12rpx; text-align: center; }

