.container { padding: 24rpx; }
.page-header { margin-bottom: 24rpx; }
.page-title { font-size: 38rpx; font-weight: 700; color: #1E4976; }
.page-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; }

.card { background: #FFF; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06); }
.card-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; }

.form-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.form-label { width: 160rpx; font-size: 28rpx; color: #333; }
.form-input { flex: 1; font-size: 28rpx; }
.form-picker { flex: 1; }
.picker-text { font-size: 28rpx; color: #1E4976; }

.submit-btn { margin-top: 28rpx; background: #1E4976; color: #FFF; text-align: center; padding: 24rpx; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; }

.result-card { border: 2rpx solid rgba(30, 73, 118,0.15); }
.score-row { display: flex; align-items: baseline; margin-bottom: 24rpx; }
.score-num { font-size: 72rpx; font-weight: 800; color: var(--c-primary); }
.score-level { font-size: 28rpx; color: #10B981; margin-left: 16rpx; }

.report-block { margin-bottom: 24rpx; }
.block-title { font-size: 28rpx; font-weight: 600; color: var(--c-text); margin-bottom: 12rpx; }
.block-line { font-size: 26rpx; color: #333; padding: 8rpx 0; }
.block-line.warn { color: #EF4444; }

.suggestion { margin-top: 16rpx; font-size: 26rpx; color: var(--c-text-2); background: var(--c-primary-tint); padding: 20rpx; border-radius: 12rpx; line-height: 1.6; }

