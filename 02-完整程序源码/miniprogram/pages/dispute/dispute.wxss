.page { padding: 0 24rpx 40rpx; background: var(--c-bg); min-height: 100vh; }
.page-header { padding: 30rpx 0 20rpx; }
.page-title { font-size: 36rpx; font-weight: 700; color: var(--c-text); }
.page-subtitle { font-size: 24rpx; color: var(--c-text-3); margin-top: 8rpx; display: block; }
.category-scroll { white-space: nowrap; margin: 16rpx 0; }
.category-list { display: inline-flex; gap: 16rpx; }
.category-item { display: inline-block; padding: 12rpx 28rpx; border-radius: 24rpx; font-size: 24rpx; color: var(--c-text-2); background: var(--c-primary-tint); border: 1rpx solid var(--c-border); }
.category-item.active { color: var(--c-primary); background: var(--c-primary-tint); border-color: var(--c-primary); }
.match-btn { display: flex; align-items: center; justify-content: center; gap: 12rpx; background: var(--c-primary-tint); border: 1rpx solid rgba(30, 73, 118,0.2); border-radius: 16rpx; padding: 20rpx; margin: 20rpx 0; }
.translation-switch { display: inline-flex; margin: -2rpx 0 12rpx; padding: 10rpx 18rpx; border-radius: 20rpx; color: var(--c-primary); background: var(--c-primary-tint); font-size: 21rpx; }
.translation-meta { display: block; margin-top: 10rpx; font-size: 19rpx; color: var(--c-text-3); }
.match-icon { font-size: 32rpx; color: var(--c-primary); }
.match-text { font-size: 26rpx; color: var(--c-primary); font-weight: 700; }
.case-list { margin-top: 20rpx; }
.case-card { background: #FFFFFF; border: 1rpx solid var(--c-border); border-radius: var(--radius-card); padding: 24rpx; margin-bottom: 20rpx; }
.case-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.case-no { font-size: 22rpx; color: var(--c-text-3); }
.case-type-tag { font-size: 20rpx; color: var(--c-warning); background: rgba(230,162,60,0.12); padding: 4rpx 16rpx; border-radius: 8rpx; }
.case-title { font-size: 30rpx; font-weight: 700; color: var(--c-text); display: block; margin-bottom: 12rpx; }
.case-meta { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.case-countries { font-size: 22rpx; color: var(--c-primary); }
.case-date { font-size: 22rpx; color: var(--c-text-3); }
.case-summary { font-size: 24rpx; color: var(--c-text-2); line-height: 1.6; display: block; }
.case-advice { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--c-divider); }
.advice-label { font-size: 22rpx; color: var(--c-primary); display: block; margin-bottom: 8rpx; }
.advice-text { font-size: 24rpx; color: var(--c-text-2); line-height: 1.6; }
.empty-state { text-align: center; padding: 80rpx 0; }
.empty-icon { font-size: 60rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 26rpx; color: var(--c-text-3); }
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.55); z-index: 100; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 85%; max-height: 80vh; background: #FFFFFF; border: 1rpx solid var(--c-border); border-radius: 20rpx; padding: 32rpx; overflow-y: auto; }
.modal-title { font-size: 32rpx; font-weight: 700; color: var(--c-text); display: block; margin-bottom: 24rpx; text-align: center; }
.modal-form { margin-bottom: 24rpx; }
.form-label { font-size: 24rpx; color: var(--c-text-3); display: block; margin-bottom: 8rpx; margin-top: 16rpx; }
.form-input { background: #FFFFFF; border: 1rpx solid var(--c-border); border-radius: 12rpx; padding: 16rpx 24rpx; font-size: 26rpx; color: var(--c-text); }
.modal-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btn-cancel, .btn-confirm { flex: 1; padding: 16rpx; border-radius: 12rpx; font-size: 28rpx; text-align: center; }
.btn-cancel { background: #F2F3F5; color: var(--c-text-2); }
.btn-confirm { background: #1E4976; color: #fff; }
.detail-modal { max-height: 85vh; }
.detail-section { margin-bottom: 20rpx; }
.section-label { font-size: 24rpx; color: var(--c-primary); font-weight: 700; display: block; margin-bottom: 8rpx; }
.section-text { font-size: 24rpx; color: var(--c-text-2); line-height: 1.6; }
.section-text.advice { color: var(--c-warning); }
.detail-footer { text-align: center; font-size: 22rpx; color: var(--c-text-3); margin: 20rpx 0; }
.btn-close { background: var(--c-primary-tint); color: var(--c-primary); border-radius: 12rpx; padding: 16rpx; font-size: 28rpx; margin-top: 16rpx; }

