.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #F4F7FA;
}

.page-header {
  margin-bottom: 24rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--c-text);
}
.page-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.sub-item {
  display: flex;
  align-items: center;
  background: #FFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.sub-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}
.sub-body {
  flex: 1;
  overflow: hidden;
}
.sub-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.sub-id {
  font-size: 22rpx;
  color: #999;
}
.sub-actions {
  display: flex;
  flex-direction: column;
}
.sub-btn {
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  margin-bottom: 12rpx;
  text-align: center;
}
.sub-btn:last-child {
  margin-bottom: 0;
}
.sub-btn.view {
  background: var(--c-primary-tint);
  color: var(--c-primary);
}
.sub-btn.unsub {
  background: #FEF0F0;
  color: #EF4444;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}
.empty-state .text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.empty-state .text-sub {
  font-size: 24rpx;
  color: #999;
}

.data-source {
  background: #FFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  margin-top: 12rpx;
}
.source-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}
.source-content {
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}
.source-notice {
  font-size: 20rpx;
  color: #BBB;
  margin-top: 10rpx;
}

