.page { padding: 0 24rpx 40rpx; background: var(--c-bg); min-height: 100vh; }
.page-header { padding: 30rpx 0 20rpx; }
.page-title { font-size: 36rpx; font-weight: 700; color: var(--c-text); }
.page-subtitle { font-size: 24rpx; color: var(--c-text-3); margin-top: 8rpx; display: block; }
.category-scroll { white-space: nowrap; margin: 16rpx 0; }
.category-list { display: inline-flex; gap: 16rpx; }
.category-item { display: inline-block; padding: 12rpx 28rpx; border-radius: 24rpx; font-size: 24rpx; color: var(--c-text-2); background: var(--c-primary-tint); border: 1rpx solid var(--c-border); }
.category-item.active { color: var(--c-primary); background: var(--c-primary-tint); border-color: var(--c-primary); }
.search-wrap { margin: 16rpx 0; }
.search-input { background: #FFFFFF; border: 1rpx solid var(--c-border); border-radius: 12rpx; padding: 16rpx 24rpx; font-size: 26rpx; color: var(--c-text); }
.term-list { margin-top: 20rpx; }
.term-card { background: #FFFFFF; border: 1rpx solid var(--c-border); border-radius: var(--radius-card); padding: 24rpx; margin-bottom: 20rpx; }
.term-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.term-cn { font-size: 30rpx; font-weight: 700; color: var(--c-text); }
.term-category { font-size: 20rpx; color: var(--c-primary); background: var(--c-primary-tint); padding: 4rpx 16rpx; border-radius: 8rpx; }
.term-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.term-label { font-size: 20rpx; color: var(--c-text-3); width: 50rpx; flex-shrink: 0; }
.term-value { font-size: 24rpx; color: var(--c-text-2); }
.term-desc { font-size: 24rpx; color: var(--c-text-3); margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid var(--c-divider); }
.term-footer { display: flex; justify-content: space-between; margin-top: 12rpx; }
.term-hs { font-size: 20rpx; color: var(--c-primary); }
.term-source { font-size: 20rpx; color: var(--c-text-3); }
.empty-state { text-align: center; padding: 80rpx 0; }
.empty-icon { font-size: 60rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 26rpx; color: var(--c-text-3); }
